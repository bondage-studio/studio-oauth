{
  "name": "@bc-studio/oauth-core",
  "version": "0.1.1",
  "description": "BC Studio OAuth 协议实现",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
