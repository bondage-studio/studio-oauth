{
  "name": "@bc-studio/oauth-resource-client",
  "version": "0.1.2",
  "description": "BC Studio OAuth 资源服务器端验证库",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "bcauth-keygen": "./bin/keygen.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "bondage-club",
    "oauth",
    "authentication",
    "resource-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondage-studio/studio-oauth.git",
    "directory": "packages/resource-client"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "keygen": "node bin/keygen.mjs"
  },
  "dependencies": {
    "@bc-studio/oauth-core": "workspace:*"
  }
}
