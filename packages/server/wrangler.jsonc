{
  "name": "bc-studio-oauth",
  "main": "src/index.js",
  "compatibility_date": "2025-07-01",
  "kv_namespaces": [
    {
      "binding": "bc_studio_oauth",
      "id": "8c03d8e7544f4d93a0b4cc40349f24b5"
    }
  ],
  "routes": [
    {
      "pattern": "auth.bondage-studio.org",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
